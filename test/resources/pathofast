        <script>
            function getParam(p) {
              var match = RegExp('[?&]' + p + '=([^&]*)').exec(window.location.search);
              return match && decodeURIComponent(match[1].replace(/\+/g, ' '));
            }
            // now we just come upto here.
            // once this is done, we will see about how to trigger the api for the conversions.
            //EAADCVmZBRDw0BO4ThQvv8h0ZAnndR2ZBcdtbvIetwJP0wnYmLtj1mjnmwPQi6eY2
            var book_on_watsapp = function(id,display_type,type,name,conversion_id){
              //gtag_report_conversion(window.location);
              var text = [];
              var base_url = "https://api.whatsapp.com/send?phone=+918956690420&text=";
              text.push("Hello, I want to book : *");
              text.push(name + "*");
              if(conversion_id != null){
                text.push(" (Id: " + conversion_id + ")");
              }
              base_url += encodeURI(text.join(""));
              window.location.assign(base_url);
            }

            document.addEventListener('input', function (event) {
                var locality = event.target.value;
                var classes = ["location_card","location_about"];
                for(var cli = 0; cli < classes.length; cli++){
                    var classz = classes[cli];
                    var divsToHide = document.getElementsByClassName(classz); //divsToHide is an array
                    for(var i = 0; i < divsToHide.length; i++){
                        if(locality == "Select A Location"){
                            divsToHide[i].style.display = "block";
                        }
                        else{
                            if(divsToHide[i].getAttribute("data-locality") == locality){
                                divsToHide[i].style.display = "block";
                            }
                            else{
                                divsToHide[i].style.display = "none";
                            }
                        }
                    }
                }
            }, false);

            document.addEventListener('click', function(event) {
                
                if (event.target.matches('.book_on_watsapp_element')){
                    event.preventDefault();
                    console.log(this);
                    var id = event.target.getAttribute("data-id");
                    var display_type = event.target.getAttribute("data-display-type");
                    var type = event.target.getAttribute("data-type");
                    var name = event.target.getAttribute("data-name");

                    if(getParam('gclid') == null){
                        book_on_watsapp(id,display_type,type,name,null);
                    }
                    else{
                        var xhr = new XMLHttpRequest();
                        xhr.open("POST", "/conversions.js", true);
                        xhr.setRequestHeader("Content-Type", "application/json");
                        xhr.onreadystatechange = function () {
                            if (xhr.readyState === 4) {
                                if (xhr.status === 200) {
                                    var response = xhr.responseText;
                                    console.log("response");
                                    console.log(response);
                                    var resp = JSON.parse(response);
                                    if (resp.conversion) {
                                        //console.log("------------ GOT CONVERSION ----------");
                                        //console.log(resp.conversion.id);
                                        book_on_watsapp(id, display_type, type, name, resp.conversion.id);
                                    } else {
                                        console.log("conversion not in response");
                                    }
                                } else {
                                    // Handle error
                                    console.error("Error:", xhr.status);
                                }
                            }
                        };
                        xhr.send(JSON.stringify({
                            'conversion': {
                                'tracking_id': getParam('gclid')
                            }
                        }));
                    }
                }
            });
        </script>

